# Environment variables for the Campus Notification Engine (names only; no real secrets)

# Server
PORT=3000
NODE_ENV=development

# Persistence (SQLite file; use :memory: for throwaway runs)
DB_PATH=./data/campus.db

# Authentication
API_KEY=campus-admin-api-key-change-in-production
JWT_SECRET=campus-jwt-secret-change-in-production
JWT_EXPIRES_IN=3600
# api_key = POST /inbox/session needs the API key (default, safer)
# public  = anyone who knows a subscriberId can mint a session (matches docs/API.md literally)
INBOX_SESSION_AUTH=api_key
RATE_LIMIT_PER_MIN=100

# Organization/Environment (single campus setup)
ORGANIZATION_ID=campus-org
ENVIRONMENT_ID=campus-env

# Email: when SMTP_HOST is empty a console provider is used (nothing leaves the machine)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@campus.edu

# Digest defaults
DIGEST_WINDOW_MS=300000

# Retry config
EMAIL_MAX_ATTEMPTS=3
EMAIL_BACKOFF_DELAYS=1000,5000,15000

# Worker
WORKER_TICK_MS=500
JOB_LOCK_TIMEOUT_MS=90000

# Inbound provider webhook verification secrets: WEBHOOK_SECRET_<PROVIDER>=<secret>
# Providers: GENERIC (HMAC-SHA256 over raw body), MAILGUN (timestamp+token HMAC).
# SENDGRID has no verifier implemented, so its webhooks are always rejected.
WEBHOOK_SECRET_GENERIC=
WEBHOOK_SECRET_MAILGUN=
WEBHOOK_SECRET_SENDGRID=
# Explicit opt-in to RECORD (never apply) unverifiable webhooks. Default false.
WEBHOOK_ALLOW_UNVERIFIED_SENDGRID=false
WEBHOOK_TIMESTAMP_TOLERANCE_S=300

# Focus Mode
FOCUS_MODE_MAX_HOURS=24
