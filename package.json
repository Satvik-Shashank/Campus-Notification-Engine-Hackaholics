{
  "name": "campus-notification-engine",
  "version": "1.0.0",
  "description": "Campus Notification Engine - HACKBACK V2 clean-room rebuild",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "engines": { "node": ">=22.5" },
  "scripts": {
